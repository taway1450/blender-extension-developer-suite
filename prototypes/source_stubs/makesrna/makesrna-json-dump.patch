+    RNA_JSON_FLAG(PROP_EDITABLE),
+    RNA_JSON_FLAG(PROP_LIB_EXCEPTION),
+    RNA_JSON_FLAG(PROP_ANIMATABLE),
+    RNA_JSON_FLAG(PROP_TEXTEDIT_UPDATE),
+    RNA_JSON_FLAG(PROP_ICONS_CONSECUTIVE),
+    RNA_JSON_FLAG(PROP_ICONS_REVERSE),
+    RNA_JSON_FLAG(PROP_HIDDEN),
+    RNA_JSON_FLAG(PROP_SKIP_SAVE),
+    RNA_JSON_FLAG(PROP_PROPORTIONAL),
+    RNA_JSON_FLAG(PROP_ID_REFCOUNT),
+    RNA_JSON_FLAG(PROP_ID_SELF_CHECK),
+    RNA_JSON_FLAG(PROP_NEVER_NULL),
+    RNA_JSON_FLAG(PROP_NEVER_UNLINK),
+    RNA_JSON_FLAG(PROP_PTR_NO_OWNERSHIP),
+    RNA_JSON_FLAG(PROP_ENUM_FLAG),
+    RNA_JSON_FLAG(PROP_CONTEXT_UPDATE),
+    RNA_JSON_FLAG(PROP_CONTEXT_PROPERTY_UPDATE),
+    RNA_JSON_FLAG(PROP_REGISTER),
+    RNA_JSON_FLAG(PROP_REGISTER_OPTIONAL),
+    RNA_JSON_FLAG(PROP_THICK_WRAP),
+    RNA_JSON_FLAG(PROP_IDPROPERTY),
+    RNA_JSON_FLAG(PROP_DYNAMIC),
+    RNA_JSON_FLAG(PROP_ENUM_NO_CONTEXT),
+    RNA_JSON_FLAG(PROP_ENUM_NO_TRANSLATE),
+    RNA_JSON_FLAG(PROP_NO_DEG_UPDATE),
+    RNA_JSON_FLAG(PROP_DEG_SYNC_ONLY),
+    RNA_JSON_FLAG(PROP_PATH_OUTPUT),
+    RNA_JSON_FLAG(PROP_PATH_SUPPORTS_BLEND_RELATIVE),
+    RNA_JSON_FLAG(PROP_PATH_SUPPORTS_TEMPLATES),
+    RNA_JSON_FLAG(PROP_SKIP_PRESET),
+    RNA_JSON_FLAG(PROP_FORCE_GEOMETRY_EVAL),
+};
+
+static const RNAJsonFlag rna_json_parm_flags[] = {
+    RNA_JSON_FLAG(PARM_REQUIRED),
+    RNA_JSON_FLAG(PARM_OUTPUT),
+    RNA_JSON_FLAG(PARM_RNAPTR),
+    RNA_JSON_FLAG(PARM_PYFUNC_REGISTER_OPTIONAL),
+};
+
+static const RNAJsonFlag rna_json_func_flags[] = {
+    RNA_JSON_FLAG(FUNC_USE_SELF_ID),
+    RNA_JSON_FLAG(FUNC_SELF_AS_RNA),
+    RNA_JSON_FLAG(FUNC_NO_SELF),
+    RNA_JSON_FLAG(FUNC_USE_SELF_TYPE),
+    RNA_JSON_FLAG(FUNC_USE_MAIN),
+    RNA_JSON_FLAG(FUNC_USE_CONTEXT),
+    RNA_JSON_FLAG(FUNC_USE_REPORTS),
+    RNA_JSON_FLAG(FUNC_REGISTER),
+    RNA_JSON_FLAG(FUNC_REGISTER_OPTIONAL),
+    RNA_JSON_FLAG(FUNC_ALLOW_WRITE),
+    RNA_JSON_FLAG(FUNC_BUILTIN),
+    RNA_JSON_FLAG(FUNC_EXPORT),
+    RNA_JSON_FLAG(FUNC_RUNTIME),
+};
+
+static const RNAJsonFlag rna_json_struct_flags[] = {
+    RNA_JSON_FLAG(STRUCT_ID),
+    RNA_JSON_FLAG(STRUCT_ID_REFCOUNT),
+    RNA_JSON_FLAG(STRUCT_UNDO),
+    RNA_JSON_FLAG(STRUCT_RUNTIME),
+    RNA_JSON_FLAG(STRUCT_NO_IDPROPERTIES),
+    RNA_JSON_FLAG(STRUCT_NO_DATABLOCK_IDPROPERTIES),
+    RNA_JSON_FLAG(STRUCT_CONTAINS_DATABLOCK_IDPROPERTIES),
+    RNA_JSON_FLAG(STRUCT_PUBLIC_NAMESPACE),
+    RNA_JSON_FLAG(STRUCT_PUBLIC_NAMESPACE_INHERIT),
+    RNA_JSON_FLAG(STRUCT_NO_CONTEXT_WITHOUT_OWNER_ID),
+};
+
+#undef RNA_JSON_FLAG
+
+template<size_t N>
+static void rna_json_flags(FILE *f, const char *key, const int flag_signed, const RNAJsonFlag (&names)[N])
+{
+  const uint32_t flag = uint32_t(flag_signed);
+  fprintf(f, ",\"%s\":[", key);
+  bool first = true;
+  for (const RNAJsonFlag &item : names) {
+    if (item.value && (flag & item.value) == item.value) {
+      fprintf(f, "%s\"%s\"", first ? "" : ",", item.name);
+      first = false;
+    }
+  }
+  fputc(']', f);
+}
+
+static const char *rna_json_type_name(PropertyType type)
+{
+  switch (type) {
+    case PROP_BOOLEAN:
+      return "boolean";
+    case PROP_INT:
+      return "int";
+    case PROP_FLOAT:
+      return "float";
+    case PROP_STRING:
+      return "string";
+    case PROP_ENUM:
+      return "enum";
+    case PROP_POINTER:
+      return "pointer";
+    case PROP_COLLECTION:
+      return "collection";
+  }
+  return "unknown";
+}
+
+static void rna_json_enum_items(FILE *f, const EnumPropertyItem *item, int totitem)
+{
+  fputs(",\"items\":[", f);
+  bool first = true;
+  for (int i = 0; item && (totitem ? i < totitem : item[i].identifier != nullptr); i++) {
+    if (item[i].identifier == nullptr) {
+      break;
+    }
+    fputs(first ? "{" : ",{", f);
+    first = false;
+    fprintf(f, "\"value\":%d,\"icon\":%d", item[i].value, item[i].icon);
+    rna_json_key(f, "identifier", item[i].identifier);
+    rna_json_key(f, "name", item[i].name);
+    rna_json_key(f, "description", item[i].description);
+    fputc('}', f);
+  }
+  fputc(']', f);
+}
+
+static void rna_json_property(FILE *f, PropertyDefRNA *dp, PropertyRNA *prop)
+{
+  fputc('{', f);
+  rna_json_string(f, "identifier");
+  fputc(':', f);
+  rna_json_string(f, prop->identifier);
+  rna_json_key(f, "type", rna_json_type_name(prop->type));
+  rna_json_key(f, "subtype", rna_property_subtypename(prop->subtype));
+  rna_json_key(f, "unit", rna_property_subtype_unit(PropertySubType(prop->subtype)));
+  rna_json_key(f, "name", prop->name);
+  rna_json_key(f, "description", prop->description);
+  rna_json_flags(f, "flag", prop->flag, rna_json_prop_flags);
+  rna_json_flags(f, "flag_parameter", prop->flag_parameter, rna_json_parm_flags);
+  fprintf(f, ",\"flag_raw\":%d", prop->flag);
+  fprintf(f, ",\"array\":[");
+  for (uint i = 0; i < prop->arraydimension; i++) {
+    fprintf(f, "%s%u", i ? "," : "", prop->arraylength[i]);
+  }
+  fputc(']', f);
+  rna_json_func(f, "getlength", prop->getlength);
+  rna_json_func(f, "editable", prop->editable);
+  rna_json_func(f, "update", prop->update);
+  if (prop->srna) {
+    rna_json_key(f, "srna", reinterpret_cast<const char *>(prop->srna));
+  }
+  if (prop->deprecated) {
+    rna_json_key(f, "deprecated", prop->deprecated->note ? prop->deprecated->note : "");
+  }
+  if (dp) {
+    if (!dp->dnastructname.is_empty()) {
+      rna_json_key(f, "dna_struct", dp->dnastructname.c_str());
+    }
+    if (!dp->dnaname.is_empty()) {
+      rna_json_key(f, "dna_name", dp->dnaname.c_str());
+    }
+    if (!dp->dnatype.is_empty()) {
+      rna_json_key(f, "dna_type", dp->dnatype.c_str());
+    }
+    if (dp->booleanbit) {
+      fprintf(f, ",\"boolean_bit\":%" PRId64, dp->booleanbit);
+    }
+  }
+
+  switch (prop->type) {
+    case PROP_BOOLEAN: {
+      BoolPropertyRNA *bprop = static_cast<BoolPropertyRNA *>(prop);
+      rna_json_func(f, "get", bprop->get);
+      rna_json_func(f, "set", bprop->set);
+      rna_json_func(f, "get_array", bprop->getarray);
+      rna_json_func(f, "set_array", bprop->setarray);
+      if (prop->arraydimension && bprop->defaultarray) {
+        fputs(",\"default\":[", f);
+        for (uint i = 0; i < prop->totarraylength; i++) {
+          fprintf(f, "%s%s", i ? "," : "", bprop->defaultarray[i] ? "true" : "false");
+        }
+        fputc(']', f);
+      }
+      else {
+        fprintf(f, ",\"default\":%s", bprop->defaultvalue ? "true" : "false");
+      }
+      break;
+    }
+    case PROP_INT: {
+      IntPropertyRNA *iprop = static_cast<IntPropertyRNA *>(prop);
+      rna_json_func(f, "get", iprop->get);
+      rna_json_func(f, "set", iprop->set);
+      rna_json_func(f, "range", iprop->range);
+      fprintf(f,
+              ",\"hard_min\":%d,\"hard_max\":%d,\"soft_min\":%d,\"soft_max\":%d",
+              iprop->hardmin,
+              iprop->hardmax,
+              iprop->softmin,
+              iprop->softmax);
+      if (prop->arraydimension && iprop->defaultarray) {
+        fputs(",\"default\":[", f);
+        for (uint i = 0; i < prop->totarraylength; i++) {
+          fprintf(f, "%s%d", i ? "," : "", iprop->defaultarray[i]);
+        }
+        fputc(']', f);
+      }
+      else {
+        fprintf(f, ",\"default\":%d", iprop->defaultvalue);
+      }
+      break;
+    }
+    case PROP_FLOAT: {
+      FloatPropertyRNA *fprop = static_cast<FloatPropertyRNA *>(prop);
+      rna_json_func(f, "get", fprop->get);
+      rna_json_func(f, "set", fprop->set);
+      rna_json_func(f, "range", fprop->range);
+      rna_json_float(f, "hard_min", fprop->hardmin);
+      rna_json_float(f, "hard_max", fprop->hardmax);
+      rna_json_float(f, "soft_min", fprop->softmin);
+      rna_json_float(f, "soft_max", fprop->softmax);
+      if (prop->arraydimension && fprop->defaultarray) {
+        fputs(",\"default\":[", f);
+        for (uint i = 0; i < prop->totarraylength; i++) {
+          fprintf(f, "%s%.9g", i ? "," : "", double(fprop->defaultarray[i]));
+        }
+        fputc(']', f);
+      }
+      else if (std::isfinite(fprop->defaultvalue)) {
+        fprintf(f, ",\"default\":%.9g", double(fprop->defaultvalue));
+      }
+      break;
+    }
+    case PROP_STRING: {
+      StringPropertyRNA *sprop = static_cast<StringPropertyRNA *>(prop);
+      rna_json_func(f, "get", sprop->get);
+      rna_json_func(f, "set", sprop->set);
+      rna_json_func(f, "search", sprop->search);
+      fprintf(f, ",\"max_length\":%d", sprop->maxlength);
+      rna_json_key(f, "default", sprop->defaultvalue);
+      break;
+    }
+    case PROP_ENUM: {
+      EnumPropertyRNA *eprop = static_cast<EnumPropertyRNA *>(prop);
+      rna_json_func(f, "get", eprop->get);
+      rna_json_func(f, "set", eprop->set);
+      rna_json_func(f, "itemf", eprop->item_fn);
+      rna_json_key(f, "native_enum_type", eprop->native_enum_type);
+      rna_json_key(f, "items_name", eprop->item ? rna_enum_id_from_pointer(eprop->item) : nullptr);
+      fprintf(f, ",\"default\":%d", eprop->defaultvalue);
+      rna_json_enum_items(f, eprop->item, eprop->totitem);
+      break;
+    }
+    case PROP_POINTER: {
+      PointerPropertyRNA *pprop = static_cast<PointerPropertyRNA *>(prop);
+      rna_json_func(f, "get", pprop->get);
+      rna_json_func(f, "set", pprop->set);
+      rna_json_func(f, "typef", pprop->type_fn);
+      rna_json_func(f, "poll", pprop->poll);
+      if (pprop->pointer_type) {
+        rna_json_key(f, "struct_type", reinterpret_cast<const char *>(pprop->pointer_type));
+      }
+      break;
+    }
+    case PROP_COLLECTION: {
+      CollectionPropertyRNA *cprop = static_cast<CollectionPropertyRNA *>(prop);
+      rna_json_func(f, "begin", cprop->begin);
+      rna_json_func(f, "lookup_string", cprop->lookupstring);
+      if (cprop->item_type) {
+        rna_json_key(f, "struct_type", reinterpret_cast<const char *>(cprop->item_type));
+      }
+      break;
+    }
+  }
+  fputc('}', f);
+}
