+/* -------------------------------------------------------------------- */
+/** \name JSON Dump
+ *
+ * With `$RNA_JSON_DUMP` set to a file path, `makesrna` writes every struct, property and function
+ * it defined into that file as JSON, after the definitions ran and before code is generated.
+ * Unlike the runtime (`bpy.types` introspection), the definitions still hold the names of the
+ * callback functions (refine, enum item, pointer type and editable functions), the DNA each
+ * property reads and the source file of each struct: facts a stub generator can't get otherwise.
+ * \{ */
+
+static void rna_json_string(FILE *f, const char *str)
+{
+  if (str == nullptr) {
+    fputs("null", f);
+    return;
+  }
+  fputc('"', f);
+  for (const unsigned char *c = reinterpret_cast<const unsigned char *>(str); *c; c++) {
+    switch (*c) {
+      case '"':
+        fputs("\\\"", f);
+        break;
+      case '\\':
+        fputs("\\\\", f);
+        break;
+      case '\n':
+        fputs("\\n", f);
+        break;
+      case '\t':
+        fputs("\\t", f);
+        break;
+      case '\r':
+        fputs("\\r", f);
+        break;
+      default:
+        if (*c < 0x20) {
+          fprintf(f, "\\u%04x", *c);
+        }
+        else {
+          fputc(*c, f);
+        }
+    }
+  }
+  fputc('"', f);
+}
+
+static void rna_json_key(FILE *f, const char *key, const char *str)
+{
+  fprintf(f, ",\"%s\":", key);
+  rna_json_string(f, str);
+}
+
+/** A callback in define mode is the name of its function (see `rna_function_string`). */
+template<typename T> static void rna_json_func(FILE *f, const char *key, T *func)
+{
+  if (func) {
+    rna_json_key(f, key, reinterpret_cast<const char *>(func));
+  }
+}
+
+static void rna_json_float(FILE *f, const char *key, float value)
+{
+  if (std::isfinite(value)) {
+    fprintf(f, ",\"%s\":%.9g", key, value);
+  }
+  else {
+    fprintf(f, ",\"%s\":\"%s\"", key, value > 0 ? "inf" : (value < 0 ? "-inf" : "nan"));
+  }
+}
+
+struct RNAJsonFlag {
+  uint32_t value;
+  const char *name;
+};
+
+#define RNA_JSON_FLAG(x) {uint32_t(x), #x}
+
