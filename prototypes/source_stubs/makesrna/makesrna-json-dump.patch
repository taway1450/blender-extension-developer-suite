+static void rna_dump_json(const char *filepath)
+{
+  FILE *f = fopen(filepath, "w");
+  if (!f) {
+    fprintf(stderr, "Unable to open file: %s\n", filepath);
+    DefRNA.error = true;
+    return;
+  }
+  fputs("{\"structs\":[\n", f);
+  bool first_struct = true;
+  for (StructDefRNA *ds = static_cast<StructDefRNA *>(DefRNA.structs.first); ds;
+       ds = static_cast<StructDefRNA *>(ds->cont.next))
+  {
+    StructRNA *srna = ds->srna;
+    fputs(first_struct ? "{" : ",\n{", f);
+    first_struct = false;
+    rna_json_string(f, "identifier");
+    fputc(':', f);
+    rna_json_string(f, srna->identifier);
+    rna_json_key(f, "base", srna->base ? srna->base->identifier : nullptr);
+    rna_json_key(f, "nested", srna->nested ? srna->nested->identifier : nullptr);
+    rna_json_key(f, "name", srna->name);
+    rna_json_key(f, "description", srna->description);
+    rna_json_key(f, "name_property", srna->nameproperty ? srna->nameproperty->identifier : nullptr);
+    rna_json_key(f, "filename", ds->filename.is_empty() ? nullptr : ds->filename.c_str());
+    rna_json_key(f, "dna", ds->dnaname.is_empty() ? nullptr : ds->dnaname.c_str());
+    rna_json_flags(f, "flag", srna->flag, rna_json_struct_flags);
+    rna_json_func(f, "refine", srna->refine);
+    rna_json_func(f, "path", srna->path);
+    rna_json_func(f, "register", srna->reg);
+    rna_json_func(f, "unregister", srna->unreg);
+    rna_json_func(f, "instance", srna->instance);
+    rna_json_func(f, "idproperties", srna->idproperties);
+    rna_json_func(f, "system_idproperties", srna->system_idproperties);
+    if (srna->prop_tag_defines) {
+      rna_json_enum_items(f, srna->prop_tag_defines, 0);
+    }
+
+    fputs(",\"properties\":[", f);
+    bool first = true;
+    for (PropertyDefRNA &dp : ds->cont.properties) {
+      if (dp.prop->flag_internal & PROP_INTERN_BUILTIN) {
+        continue;
+      }
+      if (!first) {
+        fputc(',', f);
+      }
+      first = false;
+      rna_json_property(f, &dp, dp.prop);
+    }
+    fputc(']', f);
+
+    fputs(",\"functions\":[", f);
+    first = true;
+    for (FunctionDefRNA *dfunc = static_cast<FunctionDefRNA *>(ds->functions.first); dfunc;
+         dfunc = static_cast<FunctionDefRNA *>(dfunc->cont.next))
+    {
+      FunctionRNA *func = dfunc->func;
+      fputs(first ? "{" : ",{", f);
+      first = false;
+      rna_json_string(f, "identifier");
+      fputc(':', f);
+      rna_json_string(f, func->identifier);
+      rna_json_key(f, "description", func->description);
+      rna_json_key(f, "call", dfunc->call);
+      rna_json_flags(f, "flag", func->flag, rna_json_func_flags);
+      rna_json_key(f, "return", func->c_ret ? func->c_ret->identifier : nullptr);
+      fputs(",\"parameters\":[", f);
+      bool first_parm = true;
+      for (PropertyDefRNA &dparm : dfunc->cont.properties) {
+        if (!first_parm) {
+          fputc(',', f);
+        }
+        first_parm = false;
+        rna_json_property(f, &dparm, dparm.prop);
+      }
+      fputs("]}", f);
+    }
+    fputs("]}", f);
+  }
+  fputs("\n],\"enums\":{\n", f);
+  /* The shared item arrays (`rna_enum_*_items`), which properties reference by name above. */
+  struct RNAJsonEnum {
+    const char *name;
+    const EnumPropertyItem *items;
+  };
+  static const RNAJsonEnum shared_enums[] = {
+#define RNA_MAKESRNA
+#define DEF_ENUM(id) {STRINGIFY(id), id},
+#include "RNA_enum_items.hh"
+#undef RNA_MAKESRNA
+  };
+  bool first_enum = true;
+  for (const RNAJsonEnum &item : shared_enums) {
+    fputs(first_enum ? "" : ",\n", f);
+    first_enum = false;
+    rna_json_string(f, item.name);
+    fputs(":{\"_\":0", f);
+    rna_json_enum_items(f, item.items, 0);
+    fputc('}', f);
+  }
+  fputs("\n}}\n", f);
+  fclose(f);
+}
+
