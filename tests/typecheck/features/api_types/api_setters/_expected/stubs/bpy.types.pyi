"""Reference stub delta: a math property is set from any sequence of floats (rows for a Matrix) and an array property
from any sequence of its elements, also through a slice; an array is a Sequence."""

from collections.abc import Iterable, Iterator, Sequence
from typing import Any, overload

from mathutils import Color, Euler, Matrix, Quaternion, Vector

class bpy_prop_array[_T](bpy_prop, Sequence[_T]):
    def foreach_get(self, seq: Any) -> None: ...
    def foreach_set(self, seq: Any) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, item: object, /) -> bool: ...
    @overload
    def __getitem__(self, key: int, /) -> _T: ...
    @overload
    def __getitem__(self, key: slice, /) -> tuple[_T, ...]: ...
    @overload
    def __setitem__(self, key: int, value: _T, /) -> None: ...
    @overload
    def __setitem__(self, key: slice, value: Iterable[_T], /) -> None: ...
    def __iter__(self) -> Iterator[_T]: ...

class Object:
    @property
    def location(self) -> Vector: ...
    @location.setter
    def location(self, value: Vector | Sequence[float]) -> None: ...
    @property
    def rotation_euler(self) -> Euler: ...
    @rotation_euler.setter
    def rotation_euler(self, value: Euler | Sequence[float]) -> None: ...
    @property
    def rotation_quaternion(self) -> Quaternion: ...
    @rotation_quaternion.setter
    def rotation_quaternion(self, value: Quaternion | Sequence[float]) -> None: ...
    @property
    def scale(self) -> Vector: ...
    @scale.setter
    def scale(self, value: Vector | Sequence[float]) -> None: ...
    @property
    def matrix_world(self) -> Matrix: ...
    @matrix_world.setter
    def matrix_world(self, value: Matrix | Sequence[Sequence[float]]) -> None: ...
    @property
    def lock_location(self) -> bpy_prop_array[bool]: ...
    @lock_location.setter
    def lock_location(self, value: Sequence[bool]) -> None: ...

class Light:
    @property
    def color(self) -> Color: ...
    @color.setter
    def color(self, value: Color | Sequence[float]) -> None: ...

class Material:
    @property
    def diffuse_color(self) -> bpy_prop_array[float]: ...
    @diffuse_color.setter
    def diffuse_color(self, value: Sequence[float]) -> None: ...

class Image:
    @property
    def pixels(self) -> bpy_prop_array[float]: ...
    @pixels.setter
    def pixels(self, value: Sequence[float]) -> None: ...
