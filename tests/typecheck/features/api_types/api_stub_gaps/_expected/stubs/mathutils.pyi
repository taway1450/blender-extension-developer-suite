"""Reference stub delta: a matrix row or column is a Vector; a Vector is a sequence of floats that compares by length,
and a Quaternion negates. The math types take an item or a slice and are buffers, and are made from any iterable."""

from collections.abc import Iterable, Iterator, Sequence
from typing import Self, overload

class MatrixAccess:
    def __getitem__(self, key: int, /) -> Vector: ...
    def __iter__(self) -> Iterator[Vector]: ...

class Vector(Sequence[float]):
    def cross(self, other: Sequence[float], /) -> Vector | float: ...
    def __init__(self, seq: Iterable[float] = (0.0, 0.0, 0.0), /) -> None: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, key: int, /) -> float: ...
    @overload
    def __getitem__(self, key: slice, /) -> tuple[float, ...]: ...
    def __iter__(self) -> Iterator[float]: ...
    @overload
    def __setitem__(self, key: int, value: float, /) -> None: ...
    @overload
    def __setitem__(self, key: slice, value: Iterable[float], /) -> None: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...
    def __lt__(self, other: Self, /) -> bool: ...
    def __le__(self, other: Self, /) -> bool: ...
    def __gt__(self, other: Self, /) -> bool: ...
    def __ge__(self, other: Self, /) -> bool: ...

class Quaternion:
    def __neg__(self) -> Quaternion: ...
    @overload
    def __setitem__(self, key: int, value: float, /) -> None: ...
    @overload
    def __setitem__(self, key: slice, value: Iterable[float], /) -> None: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...

class Matrix:
    @overload
    def __setitem__(self, key: int, value: Sequence[float], /) -> None: ...
    @overload
    def __setitem__(self, key: slice, value: Iterable[Sequence[float]], /) -> None: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...
