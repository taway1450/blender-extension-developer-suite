"""Reference stub delta: a matrix row or column is a Vector; a Vector is a sequence of floats that compares by length,
and a Quaternion negates."""

from collections.abc import Iterator, Sequence
from typing import Self, overload

class MatrixAccess:
    def __getitem__(self, key: int, /) -> Vector: ...
    def __iter__(self) -> Iterator[Vector]: ...

class Vector(Sequence[float]):
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, key: int, /) -> float: ...
    @overload
    def __getitem__(self, key: slice, /) -> tuple[float, ...]: ...
    def __iter__(self) -> Iterator[float]: ...
    def __lt__(self, other: Self, /) -> bool: ...
    def __le__(self, other: Self, /) -> bool: ...
    def __gt__(self, other: Self, /) -> bool: ...
    def __ge__(self, other: Self, /) -> bool: ...

class Quaternion:
    def __neg__(self) -> Quaternion: ...
